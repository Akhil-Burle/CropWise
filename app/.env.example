# Which data source the service layer uses (chosen at build/dev-server start):
#   mock  - default, fully offline demo on bundled sample data
#   local - leaf photo + soil card go to the ML backend on this machine (backend/), rest stays mock
#   http  - everything real (most services are still TODO stubs)
VITE_DATA_SOURCE=mock
# Base URL used only by the http adapters in src/services/http/. Ignored in mock mode.
# "/api" goes through the Vite proxy to http://127.0.0.1:8000 (override with CROPWISE_API_URL).
VITE_API_BASE_URL=/api
